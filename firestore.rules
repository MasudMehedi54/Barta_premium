rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Direct chat ids are "uidA_uidB". Firebase uids never contain "_", group ids neither.
    function isDirect(chatId) {
      return chatId.split('_').size() == 2;
    }

    function inChat(chatId) {
      return signedIn() && (
        (isDirect(chatId) && request.auth.uid in chatId.split('_')) ||
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
      );
    }

    // True if the user `uid` has me in their "blocked" list
    function blockedBy(uid) {
      return request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('blocked', []);
    }

    function notBlocked(chatId) {
      return !isDirect(chatId) ||
        (!blockedBy(chatId.split('_')[0]) && !blockedBy(chatId.split('_')[1]));
    }

    // Profile: everyone signed in can read; only you can change yours
    // (name, about, photoBase64, blocked list, muted list)
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if inChat(chatId);

        // Send: you must be the sender, and nobody in a direct chat may have blocked you
        allow create: if inChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && notBlocked(chatId);

        allow update: if inChat(chatId) && (
          // Edit / delete for everyone: only the sender, and sender + time can't change
          (resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.timestamp == resource.data.timestamp)
          ||
          // Reactions: any member, but only the "reactions" field and only your own entry
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.get('reactions', {})
                 .diff(resource.data.get('reactions', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
        );
      }
    }
  }
}
