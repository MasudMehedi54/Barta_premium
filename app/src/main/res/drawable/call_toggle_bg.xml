<?xml version="1.0" encoding="utf-8"?>
<!-- Mute / speaker / camera buttons: brand colour when switched on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/barta_primary" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#33FFFFFF" /></shape>
    </item>
</selector>
