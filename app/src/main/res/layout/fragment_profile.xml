<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile photo with a camera badge (tap to change) -->
        <FrameLayout
            android:id="@+id/photoBox"
            android:layout_width="128dp" android:layout_height="128dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="24dp"
            android:contentDescription="Change profile photo">
            <com.barta.app.view.AvatarView
                android:id="@+id/avatar"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/camera_badge_bg"
                android:contentDescription="Camera"
                android:padding="9dp" android:src="@drawable/ic_camera" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_muted" android:textSize="14sp" />

        <View
            android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Name -->
        <LinearLayout
            android:id="@+id/rowName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="24dp" android:paddingTop="12dp"
            android:paddingEnd="16dp" android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Name" android:textColor="@color/text_muted" android:textSize="13sp" />
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="17sp" />
        </LinearLayout>

        <!-- About -->
        <LinearLayout
            android:id="@+id/rowAbout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="24dp" android:paddingTop="12dp"
            android:paddingEnd="16dp" android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="About" android:textColor="@color/text_muted" android:textSize="13sp" />
            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="17sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/rowTheme"
            style="@style/Barta.SheetRow"
            android:layout_height="60dp"
            android:drawableStart="@drawable/ic_dark_mode" android:text="Theme" />

        <TextView
            android:id="@+id/rowBlocked"
            style="@style/Barta.SheetRow"
            android:layout_height="60dp"
            android:drawableStart="@drawable/ic_block" android:text="Blocked contacts" />

        <TextView
            android:id="@+id/rowNewGroup"
            style="@style/Barta.SheetRow"
            android:layout_height="60dp"
            android:drawableStart="@drawable/ic_group_add_grey" android:text="New group" />

        <TextView
            android:id="@+id/rowSignOut"
            style="@style/Barta.SheetRow"
            android:layout_height="60dp"
            android:drawableStart="@drawable/ic_logout" android:text="Sign out"
            android:textColor="@color/error_red" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Barta · Talk freely. Stay close."
            android:textColor="@color/text_muted" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
