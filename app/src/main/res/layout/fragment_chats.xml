<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginStart="16dp" android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_pill_bg"
        app:iconifiedByDefault="false"
        app:queryBackground="@null"
        app:queryHint="Search chats" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipFilters"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="true" android:text="All" app:chipCornerRadius="20dp" app:chipStrokeWidth="0dp"
            app:chipBackgroundColor="@color/chip_bg" app:checkedIconVisible="false" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chipUnread"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Unread" app:chipCornerRadius="20dp" app:chipStrokeWidth="0dp"
            app:chipBackgroundColor="@color/chip_bg" app:checkedIconVisible="false" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chipGroups"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Groups" app:chipCornerRadius="20dp" app:chipStrokeWidth="0dp"
            app:chipBackgroundColor="@color/chip_bg" app:checkedIconVisible="false" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/quote_bg"
        android:padding="12dp" android:text="Loading quote of the day..."
        android:textColor="@color/barta_dark" android:textSize="13sp"
        android:textStyle="italic" />

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChats"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="88dp" />
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center"
            android:padding="24dp"
            android:text="No chats yet.\nTap the button below to start one."
            android:textColor="@color/text_muted" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
