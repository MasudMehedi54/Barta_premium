<?xml version="1.0" encoding="utf-8"?>
<!-- Sent message: optional reply quote, photo, location card, text, time, reactions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/date_chip_bg" android:elevation="1dp"
        android:paddingStart="10dp" android:paddingTop="4dp"
        android:paddingEnd="10dp" android:paddingBottom="4dp"
        android:textColor="@color/text_muted" android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:orientation="vertical"
        android:paddingStart="56dp" android:paddingEnd="12dp"
        android:paddingTop="2dp" android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/bubble"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bubble_sent" android:elevation="1dp"
            android:orientation="vertical"
            android:paddingStart="8dp" android:paddingTop="5dp"
            android:paddingEnd="8dp" android:paddingBottom="4dp">

            <!-- Reply quote (tap = jump to the original message) -->
            <LinearLayout
                android:id="@+id/layoutQuote"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/quote_bar_bg"
                android:minWidth="140dp" android:orientation="vertical"
                android:paddingStart="12dp" android:paddingTop="5dp"
                android:paddingEnd="10dp" android:paddingBottom="5dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvQuoteSender"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/barta_primary" android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvQuoteText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxWidth="240dp" android:ellipsize="end" android:maxLines="2"
                    android:textColor="@color/text_muted" android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivImage"
                android:layout_width="230dp" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:layout_marginBottom="3dp"
                android:adjustViewBounds="true" android:contentDescription="Photo"
                android:scaleType="centerCrop" android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Barta.Photo" />

            <!-- Shared location card (tap = open in any map app via geo: link) -->
            <LinearLayout
                android:id="@+id/layoutLocation"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/quote_bar_bg"
                android:gravity="center_vertical" android:minWidth="210dp"
                android:orientation="horizontal"
                android:paddingStart="12dp" android:paddingTop="8dp"
                android:paddingEnd="12dp" android:paddingBottom="8dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="34dp" android:layout_height="34dp"
                    android:contentDescription="Location" android:src="@drawable/ic_location" />
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Shared location" android:textColor="@color/text_primary"
                        android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tap to open in maps" android:textColor="@color/barta_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="260dp" android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvEdited"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="edited" android:textColor="@color/text_muted"
                    android:textSize="11sp" android:textStyle="italic"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_muted" android:textSize="11sp" />
                <ImageView
                    android:id="@+id/ivStatus"
                    android:layout_width="15dp" android:layout_height="15dp"
                    android:layout_marginStart="3dp"
                    android:contentDescription="Message status"
                    android:src="@drawable/ic_tick" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reactions pill under the bubble -->
        <TextView
            android:id="@+id/tvReactions"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginTop="-4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/reaction_pill_bg" android:elevation="2dp"
            android:paddingStart="6dp" android:paddingTop="1dp"
            android:paddingEnd="6dp" android:paddingBottom="1dp"
            android:textColor="@color/text_muted" android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
